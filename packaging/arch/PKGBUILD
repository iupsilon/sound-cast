pkgname=sound-cast
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="Plays desktop audio on Chromecast speakers, one PipeWire sink per room"
arch=(x86_64)
url="https://github.com/iupsilon/sound-cast"
# No licence chosen yet.
license=(LicenseRef-unlicensed)
depends=(gcc-libs glibc libpipewire pipewire)
makedepends=(cargo clang git)
source=("sound-cast::git+file:///home/yari/Repository/sound-cast")
sha256sums=(SKIP)
# GCC LTO objects from ring's C code cannot be linked by rustc's linker.
options=(!lto)

pkgver() {
  cd sound-cast
  local v
  v=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)
  printf '%s.r%s.g%s' "$v" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd sound-cast
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd sound-cast
  # The package goes to other machines: no code tuned for this CPU (CachyOS
  # sets -march=native and target-cpu=native).
  CFLAGS=${CFLAGS//-march=native/-march=x86-64}; CFLAGS=${CFLAGS//-mtune=native/-mtune=generic}
  CXXFLAGS=${CXXFLAGS//-march=native/-march=x86-64}; CXXFLAGS=${CXXFLAGS//-mtune=native/-mtune=generic}
  RUSTFLAGS=${RUSTFLAGS//target-cpu=native/target-cpu=x86-64}
  export CFLAGS CXXFLAGS RUSTFLAGS
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

package() {
  cd sound-cast
  install -Dm755 target/release/sound-cast "$pkgdir/usr/bin/sound-cast"
  # The unit in the repository runs a cargo install; the package installs to /usr/bin.
  sed 's|^ExecStart=.*|ExecStart=/usr/bin/sound-cast|; /^# Installed with/d' sound-cast.service \
    | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/sound-cast.service"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
