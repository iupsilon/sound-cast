# Maintainer: Yari Melzani <yari.melzani@gmail.com>
pkgname=sound-cast
pkgver=0.3.0
pkgrel=1
pkgdesc="Plays desktop audio on Chromecast speakers, one PipeWire sink per room"
arch=(x86_64 aarch64)
url="https://github.com/iupsilon/sound-cast"
license=(GPL-3.0-or-later)
depends=(gcc-libs glibc libpipewire pipewire)
makedepends=(cargo clang)
install=sound-cast.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('95fedce19b3aeef0a4224a52cd10c572850828f6cd53855e33397738feca12a1')
# GCC LTO objects from ring's C code cannot be linked by rustc's linker.
options=(!lto)

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/sound-cast "$pkgdir/usr/bin/sound-cast"
  # The unit in the repository runs a cargo install; the package installs to /usr/bin.
  sed 's|^ExecStart=.*|ExecStart=/usr/bin/sound-cast|; /^# Installed with/d' sound-cast.service \
    | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/sound-cast.service"
  # The colour icon, shown by the Plasma widget in "Add Widgets".
  install -Dm644 assets/logo.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/sound-cast.svg"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
